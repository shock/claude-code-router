/**
 * Token Capture Integration Tests
 *
 * Comprehensive integration tests to verify token capture and cost calculation
 * during API response processing.
 */

import { CostCalculator } from '../../src/utils/costCalculator';
import { CostTrackingConfig } from '../../src/types/cost';

// Mock Fastify request and reply objects
interface MockRequest {
  sessionId?: string;
  body?: {
    model?: string;
  };
  url?: string;
}

interface MockPayload {
  usage?: {
    input_tokens?: number;
    output_tokens?: number;
    total_tokens?: number;
  };
  error?: any;
}

describe('Token Capture Integration Tests', () => {
  const mockConfig: CostTrackingConfig = {
    enabled: true,
    default_currency: 'USD',
    model_pricing: {
      'openai,gpt-4': {
        input_cost_per_million: 2.50,
        output_cost_per_million: 10.00
      },
      'anthropic,claude-3.5-sonnet': {
        input_cost_per_million: 3.00,
        output_cost_per_million: 15.00
      },
      'anthropic,claude-3-opus': {
        input_cost_per_million: 15.00,
        output_cost_per_million: 75.00
      },
      'google,gemini-pro': {
        input_cost_per_million: 0.50,
        output_cost_per_million: 1.50
      }
    }
  };

  let costCalculator: CostCalculator;

  beforeEach(() => {
    costCalculator = new CostCalculator(mockConfig);
  });

  describe('Basic token capture scenarios', () => {
    test('should capture valid payload with complete usage data', () => {
      const sessionId = 'test-session-1';
      const model = 'openai,gpt-4';
      const payload: MockPayload = {
        usage: {
          input_tokens: 1000,
          output_tokens: 500,
          total_tokens: 1500
        }
      };

      // Simulate the onSend hook processing
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};
      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);

      // Expected: (1000 * 2.50 / 1,000,000) + (500 * 10.00 / 1,000,000) = 0.0025 + 0.005 = 0.0075
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(sessionCost?.totalCost).toBeCloseTo(0.0075, 6);

      // Verify session data
      expect(sessionCost).toBeDefined();
      expect(sessionCost?.totalCost).toBeCloseTo(0.0075, 6);
      expect(sessionCost?.modelCosts[model]).toBeDefined();
      expect(sessionCost?.modelCosts[model].inputTokens).toBe(1000);
      expect(sessionCost?.modelCosts[model].outputTokens).toBe(500);
    });

    test('should handle payload with only input tokens', () => {
      const sessionId = 'test-session-2';
      const model = 'anthropic,claude-3.5-sonnet';
      const payload: MockPayload = {
        usage: {
          input_tokens: 800,
          output_tokens: 0
        }
      };

      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};
      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);

      // Expected: (800 * 3.00 / 1,000,000) + (0 * 15.00 / 1,000,000) = 0.0024
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(sessionCost?.totalCost).toBeCloseTo(0.0024, 6);
    });

    test('should handle payload with only output tokens', () => {
      const sessionId = 'test-session-3';
      const model = 'anthropic,claude-3-opus';
      const payload: MockPayload = {
        usage: {
          input_tokens: 0,
          output_tokens: 300
        }
      };

      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};
      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Expected: (0 * 15.00 / 1,000,000) + (300 * 75.00 / 1,000,000) = 0.0225
      expect(cost).toBeCloseTo(0.0225, 6);
    });

    test('should accumulate costs across multiple requests for same session', () => {
      const sessionId = 'test-session-4';
      const model = 'openai,gpt-4';

      // First request
      const payload1: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens: input1 = 0, output_tokens: output1 = 0 } = payload1.usage || {};
      const cost1 = costCalculator.calculateCost(sessionId, model, input1, output1);

      // Second request
      const payload2: MockPayload = {
        usage: { input_tokens: 2000, output_tokens: 1000 }
      };
      const { input_tokens: input2 = 0, output_tokens: output2 = 0 } = payload2.usage || {};
      const cost2 = costCalculator.calculateCost(sessionId, model, input2, output2);

      // Verify individual costs
      expect(cost1).toBeCloseTo(0.0075, 6); // 0.0025 + 0.005
      expect(cost2).toBeCloseTo(0.015, 6);  // 0.005 + 0.01

      // Verify accumulated session cost
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(sessionCost?.totalCost).toBeCloseTo(0.0225, 6); // 0.0075 + 0.015
      expect(sessionCost?.modelCosts[model].inputTokens).toBe(3000); // 1000 + 2000
      expect(sessionCost?.modelCosts[model].outputTokens).toBe(1500); // 500 + 1000
    });
  });

  describe('Response format variations', () => {
    test('should handle payload with total_tokens only', () => {
      const sessionId = 'test-session-5';
      const model = 'google,gemini-pro';
      const payload: MockPayload = {
        usage: {
          total_tokens: 1500
        }
      };

      // When only total_tokens is provided, we need to handle this appropriately
      // For this test, we'll simulate the behavior where input/output tokens are derived
      // or we treat it as all input tokens (conservative approach)
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};
      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // With no input/output tokens, cost should be 0
      expect(cost).toBe(0);
    });

    test('should handle payload with alternative token field names', () => {
      const sessionId = 'test-session-6';
      const model = 'openai,gpt-4';

      // Simulate payload with different field names (some providers use different naming)
      const payloadWithAlternativeNames = {
        usage: {
          prompt_tokens: 1200,  // Alternative name for input_tokens
          completion_tokens: 600, // Alternative name for output_tokens
          total_tokens: 1800
        }
      };

      // In real implementation, we would need to handle field name mapping
      // For this test, we simulate extraction logic
      const usage = payloadWithAlternativeNames.usage as any;
      const input_tokens = usage.prompt_tokens || usage.input_tokens || 0;
      const output_tokens = usage.completion_tokens || usage.output_tokens || 0;

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Expected: (1200 * 2.50 / 1,000,000) + (600 * 10.00 / 1,000,000) = 0.003 + 0.006 = 0.009
      expect(cost).toBeCloseTo(0.009, 6);
    });

    test('should handle payload with nested usage structure', () => {
      const sessionId = 'test-session-7';
      const model = 'anthropic,claude-3.5-sonnet';

      // Some providers might have nested usage structures
      const payloadWithNestedUsage = {
        data: {
          usage: {
            input_tokens: 900,
            output_tokens: 450
          }
        }
      };

      // In real implementation, we would need to handle nested structures
      // For this test, we simulate extraction from nested structure
      const nestedUsage = (payloadWithNestedUsage as any).data?.usage || {};
      const { input_tokens = 0, output_tokens = 0 } = nestedUsage;

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Expected: (900 * 3.00 / 1,000,000) + (450 * 15.00 / 1,000,000) = 0.0027 + 0.00675 = 0.00945
      expect(cost).toBeCloseTo(0.00945, 6);
    });

    test('should handle payload with multiple usage sections', () => {
      const sessionId = 'test-session-8';
      const model = 'openai,gpt-4';

      // Some responses might have multiple usage sections
      const payloadWithMultipleUsage = {
        usage: {
          prompt_tokens: 800,
          completion_tokens: 400
        },
        billing_usage: {
          input_tokens: 800,
          output_tokens: 400
        }
      };

      // In real implementation, we would need to handle multiple usage sources
      // For this test, we prioritize the main usage field
      const usage = (payloadWithMultipleUsage as any).usage || {};
      const input_tokens = usage.prompt_tokens || usage.input_tokens || 0;
      const output_tokens = usage.completion_tokens || usage.output_tokens || 0;

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Expected: (800 * 2.50 / 1,000,000) + (400 * 10.00 / 1,000,000) = 0.002 + 0.004 = 0.006
      expect(cost).toBeCloseTo(0.006, 6);
    });
  });

  describe('Model variations and configurations', () => {
    test('should handle different model name formats', () => {
      const sessionId = 'test-session-9';

      // Test various model name formats
      const modelFormats = [
        'openai,gpt-4',
        'anthropic,claude-3.5-sonnet',
        'anthropic,claude-3-opus',
        'google,gemini-pro',
        'unconfigured,model', // Should return 0 cost
        'openai,gpt-3.5-turbo' // Should return 0 cost
      ];

      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      const costs = modelFormats.map(model =>
        costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens)
      );

      // Verify configured models have costs, unconfigured return 0
      expect(costs[0]).toBeCloseTo(0.0075, 6); // openai,gpt-4
      expect(costs[1]).toBeCloseTo(0.0105, 6); // anthropic,claude-3.5-sonnet
      expect(costs[2]).toBeCloseTo(0.0525, 6); // anthropic,claude-3-opus
      expect(costs[3]).toBeCloseTo(0.00125, 6); // google,gemini-pro
      expect(costs[4]).toBe(0); // unconfigured,model
      expect(costs[5]).toBe(0); // openai,gpt-3.5-turbo
    });

    test('should handle model names with special characters', () => {
      const sessionId = 'test-session-10';

      const specialModelNames = [
        'openai,gpt-4-turbo-preview',
        'anthropic,claude-3.5-sonnet-20241022',
        'google,gemini-1.5-pro',
        'provider,model/v1'
      ];

      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      const costs = specialModelNames.map(model =>
        costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens)
      );

      // All should return 0 since they're not in the configured models
      costs.forEach(cost => {
        expect(cost).toBe(0);
      });
    });

    test('should handle case-insensitive model matching', () => {
      const sessionId = 'test-session-11';

      const caseVariations = [
        'OPENAI,GPT-4', // Uppercase
        'OpenAI,Gpt-4', // Mixed case
        'openai,gpt-4', // Lowercase (configured)
      ];

      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      const costs = caseVariations.map(model =>
        costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens)
      );

      // Only the exact lowercase match should work (current implementation is case-sensitive)
      expect(costs[0]).toBe(0); // Uppercase - not configured
      expect(costs[1]).toBe(0); // Mixed case - not configured
      expect(costs[2]).toBeCloseTo(0.0075, 6); // Lowercase - configured
    });
  });

  describe('Session management scenarios', () => {
    test('should track multiple sessions independently', () => {
      const session1 = 'session-alpha';
      const session2 = 'session-beta';
      const model = 'openai,gpt-4';

      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      // Process for session 1
      costCalculator.calculateCost(session1, model, input_tokens, output_tokens);

      // Process for session 2
      costCalculator.calculateCost(session2, model, input_tokens, output_tokens);

      // Verify sessions are independent
      const cost1 = costCalculator.getSessionCost(session1);
      const cost2 = costCalculator.getSessionCost(session2);

      expect(cost1).toBeDefined();
      expect(cost2).toBeDefined();
      expect(cost1?.sessionId).toBe(session1);
      expect(cost2?.sessionId).toBe(session2);
      expect(cost1?.totalCost).toBeCloseTo(0.0075, 6);
      expect(cost2?.totalCost).toBeCloseTo(0.0075, 6);
    });

    test('should handle session reset and reuse', () => {
      const sessionId = 'session-reset-test';
      const model = 'anthropic,claude-3.5-sonnet';

      // First usage
      const payload1: MockPayload = {
        usage: { input_tokens: 1200, output_tokens: 600 }
      };
      const { input_tokens: input1 = 0, output_tokens: output1 = 0 } = payload1.usage || {};
      costCalculator.calculateCost(sessionId, model, input1, output1);

      // Verify initial cost
      const initialCost = costCalculator.getSessionCost(sessionId);
      expect(initialCost?.totalCost).toBeCloseTo(0.0126, 6); // (1200*3 + 600*15) / 1,000,000

      // Reset session
      costCalculator.resetSession(sessionId);

      // Second usage after reset
      const payload2: MockPayload = {
        usage: { input_tokens: 800, output_tokens: 400 }
      };
      const { input_tokens: input2 = 0, output_tokens: output2 = 0 } = payload2.usage || {};
      costCalculator.calculateCost(sessionId, model, input2, output2);

      // Verify reset cost (only second usage)
      const resetCost = costCalculator.getSessionCost(sessionId);
      expect(resetCost?.totalCost).toBeCloseTo(0.0084, 6); // (800*3 + 400*15) / 1,000,000
      expect(resetCost?.modelCosts[model].inputTokens).toBe(800);
      expect(resetCost?.modelCosts[model].outputTokens).toBe(400);
    });

    test('should handle concurrent session access', async () => {
      const sessionId = 'concurrent-session';
      const model = 'openai,gpt-4';

      // Use different token counts for each call to avoid calculation cache
      const payloads = Array.from({ length: 10 }, (_, i) => ({
        usage: { input_tokens: 100 + i, output_tokens: 50 + i }
      }));

      // Simulate concurrent calls using Promise.all
      const promises = payloads.map((payload, index) => {
        const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};
        return Promise.resolve(costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens));
      });

      const results = await Promise.all(promises);

      // All calls should complete successfully
      results.forEach(cost => {
        expect(typeof cost).toBe('number');
      });

      // Session should have accumulated all tokens
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(sessionCost).toBeDefined();

      // Calculate expected total tokens
      const totalInputTokens = payloads.reduce((sum, payload, i) => sum + (100 + i), 0);
      const totalOutputTokens = payloads.reduce((sum, payload, i) => sum + (50 + i), 0);

      expect(sessionCost?.modelCosts[model].inputTokens).toBe(totalInputTokens);
      expect(sessionCost?.modelCosts[model].outputTokens).toBe(totalOutputTokens);
    });
  });

  describe('Error handling scenarios', () => {
    test('should handle payload with missing usage data', () => {
      const sessionId = 'test-session-12';
      const model = 'openai,gpt-4';

      const payloadWithoutUsage: MockPayload = {};
      const { input_tokens = 0, output_tokens = 0 } = payloadWithoutUsage.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(cost).toBe(0);
    });

    test('should handle payload with null usage', () => {
      const sessionId = 'test-session-13';
      const model = 'anthropic,claude-3.5-sonnet';

      const payloadWithNullUsage: MockPayload = {
        usage: null as any
      };
      const { input_tokens = 0, output_tokens = 0 } = payloadWithNullUsage.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(cost).toBe(0);
    });

    test('should handle payload with invalid token values', () => {
      const sessionId = 'test-session-14';
      const model = 'openai,gpt-4';

      const invalidPayloads = [
        { usage: { input_tokens: 'invalid', output_tokens: 500 } },
        { usage: { input_tokens: 1000, output_tokens: null } },
        { usage: { input_tokens: undefined, output_tokens: undefined } },
        { usage: { input_tokens: NaN, output_tokens: NaN } },
        { usage: { input_tokens: -100, output_tokens: -50 } },
        { usage: { input_tokens: Infinity, output_tokens: Infinity } }
      ];

      invalidPayloads.forEach((invalidPayload, index) => {
        const usage = (invalidPayload as any).usage || {};
        const input_tokens = Number(usage.input_tokens) || 0;
        const output_tokens = Number(usage.output_tokens) || 0;

        const cost = costCalculator.calculateCost(`${sessionId}-${index}`, model, input_tokens, output_tokens);

        // Should handle gracefully without throwing
        expect(() => cost).not.toThrow();

        // Cost should be calculable (may be 0, NaN, or Infinity depending on input)
        if (isNaN(input_tokens) || isNaN(output_tokens)) {
          expect(cost).toBeNaN();
        } else if (!isFinite(input_tokens) || !isFinite(output_tokens)) {
          expect(cost).toBe(Infinity);
        } else {
          // Valid numeric cost (could be negative)
          expect(typeof cost).toBe('number');
        }
      });
    });

    test('should handle payload with error field', () => {
      const sessionId = 'test-session-15';
      const model = 'openai,gpt-4';

      const errorPayload: MockPayload = {
        error: {
          message: 'API rate limit exceeded',
          code: 429
        }
      };

      // Even with error, if usage data exists, it should be processed
      // For this test, we simulate no usage data when error is present
      const { input_tokens = 0, output_tokens = 0 } = errorPayload.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(cost).toBe(0);
    });

    test('should handle malformed JSON in payload', () => {
      const sessionId = 'test-session-16';
      const model = 'anthropic,claude-3.5-sonnet';

      // Simulate malformed payload that might cause JSON parsing issues
      // In real implementation, this would be handled before reaching cost calculation
      const malformedPayload = {
        usage: {
          input_tokens: 1000,
          output_tokens: 500,
          // Circular reference or other problematic structures
        }
      };

      // Remove circular references for test
      const { input_tokens = 0, output_tokens = 0 } = malformedPayload.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Should calculate cost normally for valid numeric tokens
      expect(cost).toBeCloseTo(0.0105, 6); // (1000*3 + 500*15) / 1,000,000
    });
  });

  describe('Performance and async behavior', () => {
    test('should handle rapid sequential requests without blocking', async () => {
      const sessionId = 'performance-session';
      const model = 'openai,gpt-4';

      const startTime = Date.now();

      // Process 100 rapid requests
      const requests = Array.from({ length: 100 }, (_, i) => {
        const payload: MockPayload = {
          usage: { input_tokens: 10 + i, output_tokens: 5 + i }
        };
        const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};
        return costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      });

      const endTime = Date.now();
      const processingTime = endTime - startTime;

      // Should complete quickly (under 100ms for 100 requests)
      expect(processingTime).toBeLessThan(100);

      // All requests should complete successfully
      expect(requests).toHaveLength(100);
      requests.forEach(cost => {
        expect(typeof cost).toBe('number');
      });
    });

    test('should handle large volume of unique sessions', () => {
      const sessionCount = 200;
      const model = 'openai,gpt-4';

      // Create many unique sessions
      for (let i = 0; i < sessionCount; i++) {
        const sessionId = `mass-session-${i}`;
        const payload: MockPayload = {
          usage: { input_tokens: 100, output_tokens: 50 }
        };
        const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

        costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      }

      // System should handle large number of sessions without crashing
      // Note: LRUCache has capacity of 100, so older sessions will be evicted
      expect(() => costCalculator.getSessionCost('mass-session-0')).not.toThrow();
    });

    test('should maintain performance under cache pressure', () => {
      const model = 'openai,gpt-4';

      // Fill cache beyond capacity to test eviction performance
      const startTime = Date.now();

      for (let i = 0; i < 1500; i++) {
        const sessionId = `cache-pressure-${i}`;
        const payload: MockPayload = {
          usage: { input_tokens: 100, output_tokens: 50 }
        };
        const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

        costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      }

      const endTime = Date.now();
      const processingTime = endTime - startTime;

      // Should complete in reasonable time even with cache eviction
      expect(processingTime).toBeLessThan(1000); // Under 1 second for 1500 requests
    });
  });

  describe('Edge cases', () => {
    test('should handle zero tokens gracefully', () => {
      const sessionId = 'edge-case-zero';
      const model = 'openai,gpt-4';

      const zeroPayload: MockPayload = {
        usage: { input_tokens: 0, output_tokens: 0 }
      };
      const { input_tokens = 0, output_tokens = 0 } = zeroPayload.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);
      expect(cost).toBe(0);
    });

    test('should handle extremely large token counts', () => {
      const sessionId = 'edge-case-large';
      const model = 'openai,gpt-4';

      const largePayload: MockPayload = {
        usage: { input_tokens: 1000000000, output_tokens: 500000000 } // 1B input, 500M output
      };
      const { input_tokens = 0, output_tokens = 0 } = largePayload.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Expected: (1,000,000,000 * 2.50 / 1,000,000) + (500,000,000 * 10.00 / 1,000,000) = 2500 + 5000 = 7500
      expect(cost).toBeCloseTo(7500, 2);
    });

    test('should handle fractional token counts', () => {
      const sessionId = 'edge-case-fractional';
      const model = 'openai,gpt-4';

      const fractionalPayload: MockPayload = {
        usage: { input_tokens: 1234.56, output_tokens: 789.12 }
      };
      const { input_tokens = 0, output_tokens = 0 } = fractionalPayload.usage || {};

      costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);

      // Expected: (1234.56 * 2.50 / 1,000,000) + (789.12 * 10.00 / 1,000,000) = 0.0030864 + 0.0078912 = 0.0109776
      expect(cost).toBeCloseTo(0.0109776, 6);
    });

    test('should handle missing session ID', () => {
      const model = 'openai,gpt-4';

      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      // Test various missing session ID scenarios
      const missingSessionIds = ['', null as any, undefined as any];

      missingSessionIds.forEach(sessionId => {
        costCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      const sessionCost = costCalculator.getSessionCost(sessionId);
        expect(cost).toBeCloseTo(0.0075, 6);

        // Should still be able to retrieve session data if session ID is empty string
        if (sessionId === '') {
          const sessionCost = costCalculator.getSessionCost(sessionId);
          expect(sessionCost).toBeDefined();
        }
      });
    });

    test('should handle missing model in request body', () => {
      const sessionId = 'edge-case-no-model';

      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      // Test with empty model string
      const cost = costCalculator.calculateCost(sessionId, '', input_tokens, output_tokens);
      expect(cost).toBe(0); // Empty model should return 0 cost
    });

    test('should handle disabled cost tracking configuration', () => {
      const disabledConfig: CostTrackingConfig = {
        enabled: false,
        default_currency: 'USD',
        model_pricing: {}
      };

      const disabledCalculator = new CostCalculator(disabledConfig);

      const sessionId = 'disabled-config-session';
      const model = 'openai,gpt-4';
      const payload: MockPayload = {
        usage: { input_tokens: 1000, output_tokens: 500 }
      };
      const { input_tokens = 0, output_tokens = 0 } = payload.usage || {};

      const cost = disabledCalculator.calculateCost(sessionId, model, input_tokens, output_tokens);
      expect(cost).toBe(0);
    });
  });
});